# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git - it contains sensitive information

# OpenAI API key used for the Realtime voice agent.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Twilio auth token, found in the Twilio Console.
# Setting this enables request validation on /incoming-call* and token
# validation on /media-stream*. Leave unset ONLY for local development —
# without it those endpoints are unauthenticated and anyone who knows the
# URL can open realtime sessions billed to your OpenAI account.
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Port the server listens on. Railway sets this automatically.
PORT=5050
